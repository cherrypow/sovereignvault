// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = sovereign_vault

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.cherrypow.sovereignvault

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 com.sovereignvault. All rights reserved.

// App Store Connect's version record for this app was created as "1.0"
// (two-part) and cannot be edited to "1.0.0". Flutter's own version
// pipeline (pubspec.yaml, --build-name) requires full 3-part semver and
// silently coerces anything else back to X.Y.0, so it can never produce
// a literal "1.0" — these two settings bypass that pipeline entirely.
// Info.plist reads CFBundleShortVersionString/CFBundleVersion from
// these instead of $(FLUTTER_BUILD_NAME)/$(FLUTTER_BUILD_NUMBER).
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
